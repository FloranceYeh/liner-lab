{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "liner-lab",
  "version": "0.1.0",
  "identifier": "top.florance.liner-lab",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src/dist",
    "beforeDevCommand": "pnpm dev -- --host 0.0.0.0",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "liner-lab",
        "width": 1000,
        "height": 900,
        "minWidth": 900,
        "minHeight": 830,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
